# Eval data: keep the small manifest CSVs, ignore the raw download + image bytes
data/ct_ich/_raw/
data/ct_ich/images/

# RSNA external-validation data: raw download (~120MB stage_2_train.csv +
# spot-check samples) and rendered images, same as CT-ICH above.
data/rsna/_raw/
data/rsna/images/
data/rsna/pool_images*/
data/rsna/images_histmatch*/

# RSNA's competition rules prohibit redistributing "any of the data" (see
# Rules §7.A/§7.B) -- unlike CT-ICH (CC-BY), this covers derived labels too,
# not just pixels. manifest/pool_manifest CSVs must be regenerated locally
# via prep_rsna.py/build_rsna_pool.py under each user's own Kaggle agreement,
# never committed. (Purged from git history 2026-06-25; see commit log.)
data/rsna/manifest*.csv
data/rsna/pool_manifest.csv
data/rsna/Rules.txt

# RAG vector index (rebuildable from python/rag/build_kb.py)
data/rag/

# Eval result artifacts: reproducible from the scripts; keep manifests, not outputs
data/ct_ich/results*.jsonl
data/ct_ich/*summary*.json
data/rsna/results*.jsonl
data/rsna/*summary*.json
data/rsna/images_512px_control/
data/comparison.md

# Defensive test images (personal photos / downloaded medical samples) — never commit
data/test_images/defensive/

# Node deps for ad-hoc local scripts (no package.json checked in -- not reproducible anyway)
node_modules/

# Personal/ad-hoc EC2 batch-run driver, not a maintained reproducibility artifact
# (the actual reproduction commands are in README's "Reproduce any row")
run_experiments_2_3.sh

# Claude Code session-local state
.hermes/
